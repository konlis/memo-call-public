{
	"name": "memo-call",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:runtime": "node scripts/migrate.mjs",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"dev": "next dev --turbo",
		"preview": "next build && next start",
		"start": "next start",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"typecheck": "tsc --noEmit",
		"depcruise": "depcruise --config .dependency-cruiser.cjs src",
		"depcruise:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot src | dot -T svg > dependency-graph.svg"
	},
	"dependencies": {
		"@anthropic-ai/bedrock-sdk": "^0.30.2",
		"@anthropic-ai/sdk": "^0.104.2",
		"@libsql/client": "^0.14.0",
		"@t3-oss/env-nextjs": "^0.12.0",
		"@tanstack/react-query": "^5.69.0",
		"@trpc/client": "^11.0.0",
		"@trpc/react-query": "^11.0.0",
		"@trpc/server": "^11.0.0",
		"bcryptjs": "^3.0.3",
		"drizzle-orm": "^0.45.2",
		"next": "^16.2.6",
		"next-auth": "5.0.0-beta.32",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"server-only": "^0.0.1",
		"superjson": "^2.2.1",
		"twilio": "^6.0.2",
		"zod": "^3.24.2",
		"zod-to-json-schema": "^3.25.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.5",
		"@flydotio/dockerfile": "^0.7.10",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/postcss": "^4.0.15",
		"@types/node": "^22.20.1",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitest/ui": "^4.1.8",
		"dependency-cruiser": "^17.4.3",
		"drizzle-kit": "^0.31.10",
		"postcss": "^8.5.3",
		"tailwindcss": "^4.0.15",
		"tsx": "^4.22.4",
		"typescript": "^5.8.2",
		"vitest": "^4.1.8"
	},
	"ct3aMetadata": {
		"initVersion": "7.40.0"
	},
	"packageManager": "npm@11.15.0"
}
