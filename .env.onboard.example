# ─────────────────────────────────────────────────────────────────────────────
# MemoCall — operator onboarding template (deployment model A: one isolated
# single-tenant Fly app per client). Copy this file to `.env.onboard.local`
# (auto-gitignored) and fill in the client's values, then run:
#
#   node scripts/onboard.mjs            # validate + print the `fly secrets set` block
#   node scripts/onboard.mjs --smoke    # + read-only vendor pre-flight (Phase 3)
#
# The script validates EU-residency + format BEFORE printing anything. Hard
# rules are enforced as rejections (non-zero exit), not warnings.
# ─────────────────────────────────────────────────────────────────────────────

# Boot-critical (the app crashes at boot if these are wrong) ───────────────────

# libsql path on the Fly volume. MUST start with "file:".
DATABASE_URL=file:/data/db.sqlite

# Auth.js v5 JWT signing key. MUST be >= 32 chars (64 hex = 32 bytes).
# Generate: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
# NOT openssl — it is not guaranteed installed, and a failed substitution here
# yields an EMPTY value that boots into a crash-loop rather than an error.
AUTH_SECRET=

# Public origin of the panel. https:// , NO trailing slash, NO path
# (a trailing slash breaks sign-out behind Fly's proxy — OPT-26).
AUTH_URL=https://<app-name>.fly.dev

# STT — Deepgram (EU) ──────────────────────────────────────────────────────────

# Deepgram API key. MUST belong to a project provisioned in the EU region
# (the endpoint is api.eu.deepgram.com; a US-project key returns HTTP 401).
DEEPGRAM_API_KEY=

# LLM — Anthropic Claude Haiku 4.5 on Amazon Bedrock (EU) ───────────────────────

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# EU residency is a hard constraint. MUST be exactly "eu-central-1".
AWS_REGION=eu-central-1

# EU inference profile. MUST start with "eu." (the Global profile can route to
# the US and is rejected). Use Haiku/Opus, NOT Sonnet.
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# Telephony — pick ONE provider ────────────────────────────────────────────────

# REQUIRED, no default: "zadarma" or "twilio". Decides which credentials below
# are required, which provider flip the tool emits, and which panel steps it
# prints. Leaving it blank is a rejection, not a fallback — the tool used to
# assume "twilio" and would now hand you the wrong vendor's block entirely.
#
# Current project provider is "zadarma" (Latvian company, EU jurisdiction —
# the reason for the migration). "twilio" remains the documented retreat.
TELEPHONY_PROVIDER=zadarma

# The user's own GSM number the call is forwarded to / that click-to-call rings
# first. E.164 (+<country><number>). REQUIRED for BOTH providers.
USER_FORWARD_NUMBER=+48...

# ── If TELEPHONY_PROVIDER=zadarma ──────────────────────────────────────────────

# API credentials (Zadarma panel → Settings → Integrations and API).
ZADARMA_USER_KEY=
ZADARMA_SECRET=

# The BARE PBX extension the outbound callback dials FROM — e.g. 100.
# NOT the SIP login (123456-100) and NOT the PBX id (123456). A wrong value
# returns NO error: the call is placed and simply is not recorded.
# This extension is also where RECORDING is switched on — at Zadarma recording
# is a property of the extension, not of the call.
ZADARMA_SIP_EXTENSION=100

# ── If TELEPHONY_PROVIDER=twilio ───────────────────────────────────────────────

# Account SID (starts with "AC", NOT an API-Key SID which starts with "SK").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The Twilio-owned DID used as the outbound caller-id. E.164.
TWILIO_CALLER_ID=+48...

# App ──────────────────────────────────────────────────────────────────────────

# Public origin used to build the absolute recording/voice-webhook URLs.
# https:// . Usually identical to AUTH_URL. Required for both providers
# (outbound click-to-call derives its callback URL from it).
PUBLIC_BASE_URL=https://<app-name>.fly.dev

# Optional STT overrides (defaults baked into the provider) ─────────────────────
# DEEPGRAM_STT_HOST — if set, MUST be the EU host "api.eu.deepgram.com".
# DEEPGRAM_STT_HOST=api.eu.deepgram.com
# DEEPGRAM_MODEL=nova-3
