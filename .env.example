# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
DATABASE_URL="file:./db.sqlite"

#  export PATH="$HOME/.fly/bin:$PATH"
#  fly ssh console
#  node scripts/set-prod-password.mjs
# Zmiana hasła nie wylogowuje istniejących sesji (JWT 30 dni). Żeby je unieważnić:
# fly secrets set AUTH_SECRET="$(openssl rand -hex 32)".

# LLM provider (analyze + classify). Default "mock" (canned responses, no creds).
# Set to "anthropic-bedrock" to use the real provider — Anthropic Claude Haiku 4.5
# on Amazon Bedrock, EU inference profile. The provider validates all four AWS vars
# at construction (throws `auth`), so mock-mode builds need none of them.
LLM_PROVIDER="mock"
# AWS Bedrock (only when LLM_PROVIDER=anthropic-bedrock). Keys MUST belong to an
# IAM user with `bedrock:InvokeModel` on the EU inference-profile ARN + the
# foundation-model ARN, and Haiku 4.5 enabled in eu-central-1. EU residency is a
# hard product constraint — keep AWS_REGION + the `eu.` model id EU-only.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="eu-central-1"
# BEDROCK_MODEL_ID="eu.anthropic.claude-haiku-4-5-20251001-v1:0"

# Telephony (capture pipeline). Default provider "mock" (no vendor creds, no real
# calls). Set TELEPHONY_PROVIDER="twilio" + the TWILIO_* creds, or
# TELEPHONY_PROVIDER="zadarma" + the ZADARMA_* creds, for real calls.
# TELEPHONY_PROVIDER="mock"

# PUBLIC_BASE_URL — public origin used to build absolute Twilio callback URLs
# (recording-status). REQUIRED for outbound click-to-call: calls.placeOutbound
# fails INTERNAL_SERVER_ERROR without it — true in local dev too, so set it here
# to exercise /call against the mock provider.
PUBLIC_BASE_URL="http://localhost:3000"

# TWILIO_CALLER_ID — the Twilio-owned DID used as the outbound `From` for
# click-to-call (outbound-click-to-call / OPT-25). Validated lazily inside
# placeCall, so it's only needed for real outbound calls (not for mock-mode /call,
# which never reaches the provider after the success path). Real +48 outbound also
# requires +48 to be enabled in the Twilio console (Voice → Geographic
# Permissions) or Calls.create returns error 21210.
# TWILIO_CALLER_ID="+48XXXXXXXXX"

# Zadarma (telephony-provider-zadarma). Needed only with
# TELEPHONY_PROVIDER="zadarma". USER_FORWARD_NUMBER is shared with the Twilio
# branch — it is the GSM that rings first, on both inbound and outbound.
#
# ZADARMA_SIP_EXTENSION is the BARE PBX extension number ("100"), NOT the SIP
# login ("123456-100") and NOT the PBX id ("123456"). A wrong value has no error
# path: the call is placed and simply not recorded. Outbound-only — validated
# lazily inside placeCall, like TWILIO_CALLER_ID.
#
# The notification URL is configured in Zadarma's panel (account-level, one per
# account), not sent by us — there is no ZADARMA_* equivalent of PUBLIC_BASE_URL.
# ZADARMA_USER_KEY=""
# ZADARMA_SECRET=""
# ZADARMA_SIP_EXTENSION="100"